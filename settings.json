{
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py ~/.claude/tools/chronicle_index.py 2>/dev/null || true",
            "shell": "bash",
            "timeout": 30,
            "statusMessage": "Indexing chronicle...",
            "async": true
          },
          {
            "type": "command",
            "command": "[ -f graphify-out/graph.json ] && graphify update . >/dev/null 2>&1 || true",
            "shell": "bash",
            "timeout": 180,
            "statusMessage": "Refreshing code graph...",
            "async": true
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "agentPushNotifEnabled": true,
  "remoteControlAtStartup": true
}
